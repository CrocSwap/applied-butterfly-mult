{
  "scope": "Complete public-operation-sized calls on warm synthetic complex balls; no downstream theta-function timing",
  "methods": {
    "0": "pinned_library",
    "1": "unchanged_source_copy",
    "2": "shared_input_Walsh",
    "3": "direct_product_Walsh"
