+/* Private paired operation for a zero-constant input of length n.
+   The three vectors must be disjoint. */
+void
+_arb_poly_exp_inv_series(arb_ptr f, arb_ptr g,
+    arb_srcptr h, slong n, slong prec)
+{
+    slong cutoff;
+
+    FLINT_ASSERT(n > 0);
+    FLINT_ASSERT(arb_is_zero(h));
+
+    if (arb_poly_newton_exp_cutoff != 0)
+        cutoff = arb_poly_newton_exp_cutoff;
+    else if (prec <= 256)
+        cutoff = 750;
+    else
+        cutoff = 1e5 / pow(log(prec), 3);
+
+    if (n <= cutoff || n < 3)
+    {
+        _arb_poly_exp_series(f, h, n, n, prec);
+        _arb_poly_inv_series(g, f, n, n, prec);
+    }
+    else if (_arb_vec_is_zero(h + 1, n - 2))
+    {
+        /* h = b*x^(n-1): exp(+/-h) = 1 +/- h modulo x^n. */
+        arb_one(f);
+        arb_one(g);
+        _arb_vec_zero(f + 1, n - 2);
+        _arb_vec_zero(g + 1, n - 2);
+        arb_set_round(f + n - 1, h + n - 1, prec);
+        arb_neg(g + n - 1, f + n - 1);
+    }
+    else
+    {
+        /* The Newton loop already has exp(-h) through half the length.
+           Extend that inverse instead of computing it again from scratch. */
+        _arb_poly_exp_series_newton(f, g, h, n, prec, 1, cutoff);
+    }
+}
