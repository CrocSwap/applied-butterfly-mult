+        nmod_poly_mat_t A, B, C;
+        slong j, dim = 82 + 2 * i;
+        ulong mod = 1000003;
+
+        nmod_poly_mat_init(A, dim, dim, mod);
+        nmod_poly_mat_init(B, dim, dim, mod);
+        nmod_poly_mat_init(C, dim, dim, mod);
+
+        for (j = 0; j < dim; j++)
+        {
+            nmod_poly_set_coeff_ui(nmod_poly_mat_entry(A, j, j), 0, 2);
