+        FLINT_TEST(nmod_poly_mat_equal(B, C));
+        nmod_poly_mat_sqr(A, A);
+        FLINT_TEST(nmod_poly_mat_equal(A, C));
+
+        nmod_poly_mat_clear(A);
+        nmod_poly_mat_clear(B);
