+
+/* Full/low-product reconstruction from private transform scratch. Normalized
+   Garner components are consumed a tile at a time. The carry accumulator is
+   continuous across tiles and emits limbs in the original increasing order. */
+static void bf_np2_crt_tiled(const mpn_ctx_struct *R, nn_ptr z, ulong zh,
+                             double *d0, double *d1, ulong nchunks,
+                             ulong navail8, ulong bits, ulong depth)
+{
+    const sd_fft_ctx_struct *Q0=R->ffts, *Q1=R->ffts+1;
+    ulong p1u=(ulong)Q0->p;
+    vec8d P1=vec8d_set_d(Q0->p), P1i=vec8d_set_d(Q0->pinv);
+    vec8d P2=vec8d_set_d(Q1->p), P2i=vec8d_set_d(Q1->pinv);
+    vec8d C=vec8d_set_d((double)R->np2_ip1);
+    vec8d S1=vec8d_set_d((double)R->np2_s1[depth]);
+    vec8d S2=vec8d_set_d((double)R->np2_s2[depth]);
+    ulong jgar=FLINT_MIN(navail8,n_round_up(64*zh/bits+1,8));
+    ulong jtop=FLINT_MIN(nchunks,64*zh/bits+1);
+    ulong acc0=0,acc1=0,acc2=0,acc3=0,w0=0;
+    for (ulong start=0; start<jgar; start+=128)
+    {
+        ulong end=FLINT_MIN(start+128,jgar);
+        for (ulong j=start;j<end;j+=8)
+        {
+            vec8d r1=vec8d_mulmod(vec8d_load(d0+j),S1,P1,P1i);
+            vec8d r2=vec8d_mulmod(vec8d_load(d1+j),S2,P2,P2i);
+            r1=vec8d_reduce_to_0n(r1,P1,P1i);
+            r2=vec8d_reduce_to_0n(r2,P2,P2i);
+            vec8d t=vec8d_mulmod(vec8d_add(vec8d_sub(r2,r1),P2),C,P2,P2i);
+            t=vec8d_reduce_to_0n(t,P2,P2i);
+            vec8d_store(d0+j,r1);vec8d_store(d1+j,t);
+        }
+        for (ulong j=start;j<FLINT_MIN(end,jtop);j++)
+        {
+            ulong r1=(ulong)d0[j],tt=(ulong)d1[j];
+            ulong vhi,vlo,x0,x1,x2,pos=j*bits,w=pos>>6,sh=pos&63;
+            while (w0<w)
+            {
+                z[w0++]=acc0;acc0=acc1;acc1=acc2;acc2=acc3;acc3=0;
+            }
+            umul_ppmm(vhi,vlo,p1u,tt);
+            add_ssaaaa(vhi,vlo,vhi,vlo,0,r1);
+            x0=vlo<<sh;
+            x1=((vlo>>(63-sh))>>1)|(vhi<<sh);
+            x2=(vhi>>(63-sh))>>1;
+            add_ssssaaaaaaaa(acc3,acc2,acc1,acc0,
+                             acc3,acc2,acc1,acc0,0,x2,x1,x0);
+        }
+    }
+    while (w0<zh)
+    {
+        z[w0++]=acc0;acc0=acc1;acc1=acc2;acc2=acc3;acc3=0;
+    }
+}
