--- a/src/arb_poly/test/t-evaluate2_rectangular.c
+++ b/src/arb_poly/test/t-evaluate2_rectangular.c
@@ -60,5 +60,63 @@
         arb_clear(z2);
     }
 
+
+    /* Exact dyadic Horner references cover block boundaries, the automatic
+       high-precision dispatch, and either output aliasing the point. */
+    {
+        const slong lengths[] = {0, 1, 2, 3, 4, 8, 15, 16, 17,
+                                 24, 25, 26, 31, 32, 33, 63, 64, 65,
+                                 127, 128, 129};
+        const slong precisions[] = {32, 128, 1024, 4096};
+        slong li, pi, j, alg, point;
+        arb_poly_t f, df;
+        arb_t x, y, z, exact_y, exact_z, coefficient;
+
+        arb_poly_init(f); arb_poly_init(df);
+        arb_init(x); arb_init(y); arb_init(z);
+        arb_init(exact_y); arb_init(exact_z); arb_init(coefficient);
+        for (li = 0; li < 21; li++)
+        {
+            arb_poly_zero(f);
+            for (j = 0; j < lengths[li]; j++)
+            {
+                arb_set_si(coefficient, (7 * j) % 19 - 9);
+                arb_mul_2exp_si(coefficient, coefficient, -3);
+                arb_poly_set_coeff_arb(f, j, coefficient);
+            }
+            arb_poly_derivative(df, f, ARF_PREC_EXACT);
+            for (point = 0; point < 3; point++)
+            {
+                arb_set_si(x, point == 0 ? 0 : (point == 1 ? 3 : 8));
+                arb_mul_2exp_si(x, x, -3);
+                
+                arb_poly_evaluate_horner(exact_y, f, x, ARF_PREC_EXACT);
+                arb_poly_evaluate_horner(exact_z, df, x, ARF_PREC_EXACT);
+                for (pi = 0; pi < 4; pi++)
+                for (alg = 0; alg < 2; alg++)
+                {
+                    void (*evaluate)(arb_t, arb_t, const arb_poly_t,
+                                     const arb_t, slong) = alg ?
+                        arb_poly_evaluate2 : arb_poly_evaluate2_rectangular;
+                    evaluate(y, z, f, x, precisions[pi]);
+                    if (!arb_contains(y, exact_y) || !arb_contains(z, exact_z))
+                        TEST_FUNCTION_FAIL("exact evaluation: n=%wd prec=%wd\n",
+                                           lengths[li], precisions[pi]);
+                    arb_set(y, x);
+                    evaluate(y, z, f, y, precisions[pi]);
+                    if (!arb_contains(y, exact_y) || !arb_contains(z, exact_z))
+                        TEST_FUNCTION_FAIL("value aliases point\n");
+                    arb_set(z, x);
+                    evaluate(y, z, f, z, precisions[pi]);
+                    if (!arb_contains(y, exact_y) || !arb_contains(z, exact_z))
+                        TEST_FUNCTION_FAIL("derivative aliases point\n");
+                }
+            }
+        }
+        arb_poly_clear(f); arb_poly_clear(df);
+        arb_clear(x); arb_clear(y); arb_clear(z);
+        arb_clear(exact_y); arb_clear(exact_z); arb_clear(coefficient);
+    }
+
     TEST_FUNCTION_END(state);
 }
