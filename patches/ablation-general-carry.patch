+/* Ablation: general-carry. Full/low-product reconstruction from private transform scratch. Normalized
+   Garner components are consumed eight at a time without array writeback. The carry accumulator is
+   continuous across tiles and emits limbs in the original increasing order. */
+static void bf_np2_crt_tiled(const mpn_ctx_struct *R, nn_ptr z, ulong zh,
+                             double *d0, double *d1, ulong nchunks,
+                             ulong navail8, ulong bits, ulong depth)
+{
+    const sd_fft_ctx_struct *Q0=R->ffts, *Q1=R->ffts+1;
+    ulong p1u=(ulong)Q0->p;
+    vec8d P1=vec8d_set_d(Q0->p), P1i=vec8d_set_d(Q0->pinv);
+    vec8d P2=vec8d_set_d(Q1->p), P2i=vec8d_set_d(Q1->pinv);
+    vec8d C=vec8d_set_d((double)R->np2_ip1);
+    vec8d S1=vec8d_set_d((double)R->np2_s1[depth]);
+    vec8d S2=vec8d_set_d((double)R->np2_s2[depth]);
+    FLINT_ASSERT(n_round_up(FLINT_MIN(nchunks,64*zh/bits+1),8)<=navail8);
+    ulong jtop=FLINT_MIN(nchunks,64*zh/bits+1);
+    ulong acc0=0,acc1=0,acc2=0,acc3=0,w0=0;
+#define BF_EMIT(K) do { \
+    ulong j=start+(K),r1=rr[K],tt=ttv[K]; \
+    ulong vhi,vlo,x0,x1,x2,pos=j*bits,w=pos>>6,sh=pos&63; \
+    /* bits < 64: consecutive coefficients advance by at most one limb. */ \
+    while (w0<w) { z[w0++]=acc0;acc0=acc1;acc1=acc2;acc2=acc3;acc3=0; } \
+    umul_ppmm(vhi,vlo,p1u,tt); \
+    add_ssaaaa(vhi,vlo,vhi,vlo,0,r1); \
+    x0=vlo<<sh; x1=((vlo>>(63-sh))>>1)|(vhi<<sh); x2=(vhi>>(63-sh))>>1; \
+    add_ssssaaaaaaaa(acc3,acc2,acc1,acc0,acc3,acc2,acc1,acc0,0,x2,x1,x0); \
+} while (0)
+    for (ulong start=0;start<jtop;start+=8)
+    {
+        vec8d r1=vec8d_mulmod(vec8d_load(d0+start),S1,P1,P1i);
+        vec8d r2=vec8d_mulmod(vec8d_load(d1+start),S2,P2,P2i);
+        r1=vec8d_reduce_to_0n(r1,P1,P1i);r2=vec8d_reduce_to_0n(r2,P2,P2i);
+        vec8d t=vec8d_mulmod(vec8d_add(vec8d_sub(r2,r1),P2),C,P2,P2i);
+        t=vec8d_reduce_to_0n(t,P2,P2i);
+        ulong rr[8],ttv[8];
+        vec4n_store_unaligned(rr,vec4d_convert_limited_vec4n(r1.e1));
+        vec4n_store_unaligned(rr+4,vec4d_convert_limited_vec4n(r1.e2));
+        vec4n_store_unaligned(ttv,vec4d_convert_limited_vec4n(t.e1));
+        vec4n_store_unaligned(ttv+4,vec4d_convert_limited_vec4n(t.e2));
+        for (ulong k=0;k<FLINT_MIN(8,jtop-start);k++) { BF_EMIT(k); }
+    }
+#undef BF_EMIT
+    while (w0<zh)
+    {
+        z[w0++]=acc0;acc0=acc1;acc1=acc2;acc2=acc3;acc3=0;
+    }
+}
