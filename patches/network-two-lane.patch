+static void sd_ifft_basecase_4_1(const sd_fft_ctx_t Q, double* X)
+{
+    vec2d n=vec2d_set_d(Q->p), ninv=vec2d_set_d(Q->pinv);
+    vec2d x0=vec2d_load(X+0);
