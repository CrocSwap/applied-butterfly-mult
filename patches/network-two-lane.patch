+    vec2d x2=vec2d_load(X+4);
+    vec2d x3=vec2d_load(X+6);
+    vec2d x4=vec2d_load(X+8);
+    vec2d x5=vec2d_load(X+10);
+    vec2d x6=vec2d_load(X+12);
+    vec2d x7=vec2d_load(X+14);
+    {
+        vec2d w=vec2d_set_d2(-1.0,Q->w2tab[1][0]);
+        LENGTH2INV_ANY_J(vec2d,x0,x1,n,ninv,w);
+        vec2d lo=vec2d_unpacklo(x0,x1),hi=vec2d_unpackhi(x0,x1);
+        x0=lo;x1=hi;
+    }
+    {
+        vec2d w=vec2d_set_d2(Q->w2tab[2][1],Q->w2tab[2][0]);
+        LENGTH2INV_ANY_J(vec2d,x2,x3,n,ninv,w);
+        vec2d lo=vec2d_unpacklo(x2,x3),hi=vec2d_unpackhi(x2,x3);
+        x2=lo;x3=hi;
+    }
+    {
+        vec2d w=vec2d_set_d2(Q->w2tab[3][3],Q->w2tab[3][2]);
+        LENGTH2INV_ANY_J(vec2d,x4,x5,n,ninv,w);
+        vec2d lo=vec2d_unpacklo(x4,x5),hi=vec2d_unpackhi(x4,x5);
