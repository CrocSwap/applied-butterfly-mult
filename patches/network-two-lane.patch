+    sd_ifft_basecase_4_0(Q,X+16,2*j_mr+0,j_bits+1);
+    RADIX_2_REVERSE_PARAM_J_IS_NZ(vec8d,Q,j_mr,j_bits);
+    for (ulong i=0;i<16;i+=8) {
+        RADIX_2_REVERSE_MOTH_J_IS_NZ(vec8d,X+i,X+16+i);
+    }
