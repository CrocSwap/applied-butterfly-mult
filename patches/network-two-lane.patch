+    }
+    {
+        vec2d w=vec2d_set_d2(Q->w2tab[3+j_bits][8*j_mr+3],Q->w2tab[3+j_bits][8*j_mr+2]);
+        LENGTH2INV_ANY_J(vec2d,x4,x5,n,ninv,w);
