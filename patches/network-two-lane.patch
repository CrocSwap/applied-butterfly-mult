+
+static void sd_ifft_basecase_2_1(const sd_fft_ctx_t Q, double* X)
+{
+    LENGTH4INV_ZERO_J(vec1d, X[0], X[1], X[2], X[3], Q->p, Q->pinv, Q->w2tab[1][0]);
+}
