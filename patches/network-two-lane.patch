+        vec2d lo=vec2d_unpacklo(x6,x7),hi=vec2d_unpackhi(x6,x7);
+        x6=lo;x7=hi;
+    }
+    LENGTH8INV_ZERO_J(vec2d,x0,x1,x2,x3,x4,x5,x6,x7,n,ninv,vec2d_set_d(Q->w2tab[1][0]),vec2d_set_d(Q->w2tab[2][1]),vec2d_set_d(Q->w2tab[2][0]));
+    vec2d_store(X+0,x0);
+    vec2d_store(X+2,x1);
+    vec2d_store(X+4,x2);
+    vec2d_store(X+6,x3);
+    vec2d_store(X+8,x4);
+    vec2d_store(X+10,x5);
+    vec2d_store(X+12,x6);
+    vec2d_store(X+14,x7);
+}
