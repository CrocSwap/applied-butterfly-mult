+
+static void sd_ifft_basecase_5_1(const sd_fft_ctx_t Q, double* X)
+{
+    sd_ifft_basecase_4_1(Q,X);
+    sd_ifft_basecase_4_0(Q,X+16,0,1);
+    RADIX_2_REVERSE_PARAM_J_IS_Z(vec8d,Q);
+    for (ulong i=0;i<16;i+=8) {
+        RADIX_2_REVERSE_MOTH_J_IS_Z(vec8d,X+i,X+16+i);
