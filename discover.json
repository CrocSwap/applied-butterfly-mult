{
  "schema": "discover/v0",
  "title": "Applied butterfly multiplication",
  "summary": "Measured, reproducible speedups to FLINT multiplication and related routines on Apple M2, derived from finite-network and representation ideas, with exact correctness checks and interleaved controls.",
  "domains": [
    "algorithms",
    "computer-arithmetic",
    "performance-engineering"
  ],
  "license": "LGPL-3.0-or-later",
  "maintainers": [
    {
      "name": "CrocSwap maintainers",
      "github": "Mister-Meeseeks"
    }
  ],
  "canonical_repo": "https://github.com/CrocSwap/applied-butterfly-mult",
  "entry": {
    "agents": "AGENTS.md",
    "project": "DISCOVERY.md",
    "brief": "README.md"
  },
  "frontier": "discover/frontier.json",
  "catalog": "discover/catalog.json",
  "priority_log": "discover/priority-log.md",
  "ledger": "discover/ledger.md",
  "packages": "results/*/",
  "coordination": {
    "transport": "github-discussions",
    "threads": {
      "start": 12,
      "handoffs": 13,
      "proposals": 14,
      "feedback": 15
    },
    "claim_ttl_minutes": 120
  },
  "overlap": {
    "sources": [
      "open-prs",
      "pr-files",
      "packages",
      "ledger"
    ]
  },
  "session": {
    "default_minutes": 60,
    "orient_fraction": 0.2,
    "verify_fraction": 0.25
  },
  "permissions": {
    "post_messages": true,
    "open_prs": true,
    "maintainer_only": [
      "merge",
      "close-others-prs",
      "change-frontier"
    ]
  },
  "verification_profile": "benchmark",
  "credit": {
    "policy": "Contributors whose work is accepted are acknowledged by name (GitHub handle) in the review ledger, discover/ledger.md, with what they contributed. Verification reports that count toward acceptance are credited the same way.",
    "kinds": [
      "acknowledgement"
    ]
  },
  "hubs": [
    {
      "hub": "discoveryathome/discover",
      "list": true
    }
  ]
}
